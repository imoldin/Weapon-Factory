<Project Sdk="Microsoft.NET.Sdk">
  <!-- Type-checks runtime + editor scripts against Unity reference assemblies (UnityEditor 2021.1 API). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>WeaponFactory.EditorCompileCheck</AssemblyName>
    <NoWarn>CS0649;CS1701;CS1702</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../UGuiStub.cs" />
    <Compile Include="../../../Assets/_Project/Scripts/**/*.cs" />
    <Compile Include="../../../Assets/_Project/Editor/**/*.cs" />
    <Reference Include="$(UnityModules)/*.dll" Private="false" />
    <Reference Include="$(UnityEditorDll)" Private="false" />
  </ItemGroup>
</Project>
